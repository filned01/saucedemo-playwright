{
  "name": "saucedemo-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright test automation framework for the SauceDemo e-commerce demo site.",
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:auth": "playwright test tests/auth.spec.ts",
    "test:products": "playwright test tests/products.spec.ts",
    "test:cart": "playwright test tests/cart.spec.ts",
    "test:checkout": "playwright test tests/checkout.spec.ts",
    "test:menu": "playwright test tests/burger-menu.spec.ts",
    "report": "playwright show-report",
    "test:debug": "playwright test --debug"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
