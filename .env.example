# Copy to .env and adjust. Values in .env override config/environments.json.
# Already-set shell/CI variables always win over .env.

# Which environments to load as Playwright projects: qa | dev | prod | all
TEST_ENV=qa

# Per-environment base URLs (optional overrides)
QA_BASE_URL=https://www.saucedemo.com
DEV_BASE_URL=https://www.saucedemo.com
PROD_BASE_URL=https://www.saucedemo.com

# Compatibility alias used for QA and DEV when the specific *_BASE_URL is unset
# BASE_URL=https://www.saucedemo.com
